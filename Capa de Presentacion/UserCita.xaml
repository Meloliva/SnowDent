<UserControl x:Class="Capa_de_Presentacion.UserCita"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="1200">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20">

                <!-- Título -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Agendar Cita"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Formulario -->
                <Border Background="White" CornerRadius="20" Padding="30" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- DNI y botón Buscar -->
                        <TextBlock Text="DNI del Paciente:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="tbdni" Width="200" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                     FontSize="13" VerticalContentAlignment="Center"/>
                            <Button x:Name="btnbuscar" Content="🔍 Buscar" Width="100" Height="35" Background="#007ACC" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="10,0,0,0" Click="btnbuscar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Nombres:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="tbnombre" IsReadOnly="True" Height="35" Background="#F2F2F2" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="Apellidos:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="tbapellido" IsReadOnly="True" Height="35" Background="#F2F2F2" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>


                        <TextBlock Text="Especialidad:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cbespecialidad" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                  FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="Id">
                        </ComboBox>

                            <TextBlock Text="Odontólogo:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cbodontologo" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                  FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="Id"/>

                        <TextBlock Text="Fecha:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dtfecha" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                    FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Hora (ej: 15:30):" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="tbhora" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Botones -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button x:Name="btnguardar" Content="💾 Guardar" Width="120" Height="40" Background="#5EB956" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnguardar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btneditar" Content="✏️ Editar" Width="120" Height="40" Background="Gray" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnmodificar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btneliminar" Content="🗑️ Eliminar" Width="120" Height="40" Background="Red" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnEliminar">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>

                        <!-- DataGrid -->
                        <TextBlock Text="Lista de Citas" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="15" Padding="10" HorizontalAlignment="Stretch">
                            <DataGrid x:Name="dgCitas" AutoGenerateColumns="False" SelectionChanged="dgCitas_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdCita}" />
                                    <DataGridTextColumn Header="DNI Paciente" Binding="{Binding PacienteDNI}" />
                                    <DataGridTextColumn Header="Nombre Paciente" Binding="{Binding NombrePaciente}" />
                                    <DataGridTextColumn Header="Apellido Paciente" Binding="{Binding ApellidoPaciente}" />
                                    <DataGridTextColumn Header="DNI Odontólogo" Binding="{Binding OdontologoDNI}" />
                                    <DataGridTextColumn Header="Nombre Odontólogo" Binding="{Binding NombreOdontologo}" />
                                    <DataGridTextColumn Header="Apellido Odontólogo" Binding="{Binding ApellidoOdontologo}" />
                                    <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" />
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>