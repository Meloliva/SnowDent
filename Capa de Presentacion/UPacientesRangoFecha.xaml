<UserControl x:Class="Capa_de_Presentacion.UPacientesRangoFecha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1200">
    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Width="Auto">

                <!-- TÍTULO -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Pacientes por Rango de Fecha de Registro"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- FORMULARIO -->
                <Border Background="White" CornerRadius="20" Padding="30" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- Fechas -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Fecha Inicio:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <DatePicker x:Name="DpFechaInicio" Width="200"/>
                            </StackPanel>
                            <StackPanel Margin="10">
                                <TextBlock Text="Fecha Fin:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <DatePicker x:Name="DpFechaFin" Width="200"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Botón Buscar -->
                        <Button x:Name="BtnBuscar"
                                Content="🔍 Buscar"
                                Width="140"
                                Height="40"
                                Background="#007ACC"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                FontSize="13"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                            </Button.Effect>
                        </Button>

                        <!-- DataGrid -->
                        <TextBlock Text="Lista de Pacientes:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="15" Padding="10" HorizontalAlignment="Stretch">
                            <DataGrid x:Name="dgPacientesxFecha"
                                      AutoGenerateColumns="True"
                                      MinHeight="200"
                                      FontSize="13"
                                      AlternatingRowBackground="#F2F9FF"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HorizontalAlignment="Stretch"/>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>