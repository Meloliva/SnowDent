<UserControl x:Class="Capa_de_Presentacion.UPacientesConTratamientos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1400">
    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="30" Width="Auto">

                <!-- Título -->
                <Border Background="White" CornerRadius="30" Padding="35" Margin="0,30,0,30"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="18" ShadowDepth="6" Opacity="0.25"/>
                    </Border.Effect>
                    <TextBlock Text="Pacientes con Tratamientos en curso"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- DataGrid de pacientes con tratamientos -->
                <Border Background="White" CornerRadius="30" Padding="30" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch" Height="520">
                    <StackPanel>
                        <TextBlock Text="Listado de pacientes con tratamientos en curso:" FontWeight="Bold" FontSize="22" Margin="0,0,0,18"/>
                        <DataGrid x:Name="dgPacientesConTratamientos"
                                  AutoGenerateColumns="True"
                                  FontSize="18"
                                  RowHeight="38"
                                  ColumnHeaderHeight="38"
                                  AlternatingRowBackground="#F2F9FF"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MinHeight="350"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="0"
                                  />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>