<UserControl x:Class="Capa_de_Presentacion.URegistroOdontologo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="520">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Width="Auto">

                <!-- TÍTULO -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Registrar Odontólogo"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- FORMULARIO -->
                <Border Background="White" CornerRadius="20" Padding="30" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- Nombre -->
                        <TextBlock Text="Nombres:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtNombres" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,10" FontSize="13" VerticalContentAlignment="Center"/>

                        <!-- Apellidos -->
                        <TextBlock Text="Apellidos:" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtApellidos" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,10" FontSize="13" VerticalContentAlignment="Center"/>

                        <!-- DNI -->
                        <TextBlock Text="DNI:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtDNI" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,10" FontSize="13" MaxLength="9" VerticalContentAlignment="Center"/>

                        <!-- Especialidad -->
                        <TextBlock Text="Especialidad:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbEspecialidad" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,10" FontSize="13" VerticalContentAlignment="Center">
                            
                        </ComboBox>

                        <!-- Turno -->
                        <TextBlock Text="Turno:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbTurno" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,10" FontSize="13" VerticalContentAlignment="Center" DisplayMemberPath="RangoHorario"
                        SelectedValuePath="TurnoId">
                            
                        </ComboBox>

                        <!-- Username -->
                        <TextBlock Text="Username:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtUsername" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,10" FontSize="13" VerticalContentAlignment="Center"/>

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="txtContrasena" Height="35" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,0,20" FontSize="13" VerticalContentAlignment="Center"/>
                        <!-- Botones -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button x:Name="btnguardar" Content="💾 Guardar" Width="120" Height="40" Background="#5EB956" Foreground="White"
                                FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnGuardar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btneditar" Content="✏️ Editar" Width="120" Height="40" Background="Gray" Foreground="White"
                             FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnModificar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btneliminar" Content="🗑️ Eliminar" Width="120" Height="40" Background="Red" Foreground="White"
                                 FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnEliminar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Lista de Citas" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="15" Padding="10" HorizontalAlignment="Stretch">
                            <DataGrid x:Name="dgOdontologos"
                            AutoGenerateColumns="True"
                            MinHeight="200"
                            FontSize="13"
                            AlternatingRowBackground="#F2F9FF"
                            HeadersVisibility="Column"
                            GridLinesVisibility="None"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="dgOdontologos_SelectionChanged"
                            />
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>