<UserControl x:Class="Capa_de_Presentacion.UDetalleHistoriaClinica"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1200">
    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Width="Auto">

                <!-- TÍTULO -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Historial General"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            HorizontalAlignment="Center"/>
                </Border>

                <!-- FORMULARIO -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Buscar por DNI:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtDni" Width="140" Height="30" Background="#EAF7FF" BorderBrush="Transparent"
                              FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="BtnBuscar" Content="🔍 Buscar" Width="90" Height="30" Background="#3498DB" Foreground="White"
                             FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnBuscar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" BlurRadius="8" Opacity="0.2"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Border>
                

                <!-- TABLA -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,10"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Historial general:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgHistorialesClinicos"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="10"
                                  ColumnHeaderHeight="30"
                                  RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Historial General" Binding="{Binding IdHistorialGeneral}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="ID Caso Clínico" Binding="{Binding IdCasoClinico}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="ID Cita" Binding="{Binding IdCita}" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn Header="Tipo de Tratamiento" Binding="{Binding TipoTratamiento}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="Estado del Tratamiento" Binding="{Binding EstadoTratamiento}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="DNI Paciente" Binding="{Binding DNIPaciente}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Nombre Paciente" Binding="{Binding NombrePaciente}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="DNI Odontólogo" Binding="{Binding DNIOdontologo}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" Width="Auto" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>