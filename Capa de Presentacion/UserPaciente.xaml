<UserControl x:Class="Capa_de_Presentacion.UserPaciente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="1200">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20">

                <!-- TÍTULO -->
                <Border Background="White" CornerRadius="20" Padding="20"
                        Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Datos del Paciente"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- FORMULARIO -->
                <Border Background="White" CornerRadius="20" Padding="30"
                        Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- Campos -->
                        <TextBlock Text="Nombres:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtNombre" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="Apellidos:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtApellido"  Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="DNI:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtDNI" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" MaxLength="9" Margin="0,0,0,10"/>

                        <TextBlock Text="Celular:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtCelular" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="Género:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cbGenero" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                  FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10">
                            <ComboBoxItem Content="Masculino"/>
                            <ComboBoxItem Content="Femenino"/>
                            <ComboBoxItem Content="Otro"/>
                        </ComboBox>

                        <TextBlock Text="Email:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEmail" Height="35" Background="#EAF7FF" BorderBrush="Transparent"
                                 FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                        <!-- BOTONES -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button x:Name="btnGuardar" Content="💾 Guardar" Width="120" Height="40" Background="#5EB956" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnGuardar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btnModificar"    Content="✏️ Modificar" Width="120" Height="40" Background="Gray" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnModificar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btnEliminar"  Content="🗑️ Eliminar" Width="120" Height="40" Background="Red" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="btnEliminar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>

                        <!-- DATAGRID -->
                        <TextBlock Text="Lista de Pacientes" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="15" Padding="10" HorizontalAlignment="Stretch">
                            <DataGrid x:Name="dgPacientes" AutoGenerateColumns="False" SelectionChanged="dgPacientes_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" />
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" />
                                    <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" />
                                    <DataGridTextColumn Header="Celular" Binding="{Binding Celular}" />
                                    <DataGridTextColumn Header="Género" Binding="{Binding Genero}" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                                    <DataGridTextColumn Header="Fecha Registro" Binding="{Binding FechaRegistro, StringFormat=dd/MM/yyyy}" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>