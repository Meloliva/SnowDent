<UserControl x:Class="Capa_de_Presentacion.UserCantidadGenero"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="1200">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Top">

                <!-- TÍTULO -->
                <Border Background="White" CornerRadius="20" Padding="20"
                        Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Cantidad de Pacientes por Género"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- GRÁFICO -->
                <Border Background="White" CornerRadius="20" Padding="30"
                        Margin="0,0,0,0" HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="5" Opacity="0.2"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0" Width="Auto">
                        <TextBlock Text="Gráfico circular de pacientes registrados por género"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                                   TextAlignment="Center"/>
                        <lvc:PieChart x:Name="pieChartGenero"
                                      Height="450"
                                      Width="600"
                                      LegendLocation="Right"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>