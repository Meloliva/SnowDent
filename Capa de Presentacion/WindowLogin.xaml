<Window x:Class="Capa_de_Presentacion.WindowLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capa_de_Presentacion"
        mc:Ignorable="d"
        Title="WindowLogin" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" >
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                <GradientStop Color="#A593DC" Offset="1"/>
                <GradientStop  Color="#00B3CC" Offset="0"/>


            </LinearGradientBrush>
        </Grid.Background>
        <Border Height="371" VerticalAlignment="Top" CornerRadius="0 0 180 0" Background="#222222
                ">
            <Label x:Name="linkcontraseña"/>
        </Border>
        <Image  Source="Images/logo-principal.png" HorizontalAlignment="Left" Height="155" Margin="64,123,0,0" VerticalAlignment="Top" Width="221" RenderTransformOrigin="0.498,0.632">

        </Image>
        <DockPanel HorizontalAlignment="Left" Height="220" LastChildFill="False" Margin="0,140,0,0" VerticalAlignment="Top" Width="247"/>
        <Image Source="Images/imagen-de-perfil (1).png
               " Margin="384,102,389,313" RenderTransformOrigin="1.45,2.21"/>
        <Image Source="Images/bloquear.png"  HorizontalAlignment="Left" Height="28" Margin="384,156,0,0" VerticalAlignment="Top" Width="27" RenderTransformOrigin="2.697,1.2"/>
        <TextBox x:Name="tbusuario" HorizontalAlignment="Left" Height="23" Margin="427,114,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="196" Background="#222222" BorderBrush="White" BorderThickness="0,0,0,1" TextChanged="tbusuario_TextChanged" Foreground="White"/>
        <PasswordBox x:Name="tbcontraseña"
             HorizontalAlignment="Left"
             Height="23"
             Margin="427,161,0,0"
             VerticalAlignment="Top"
             Width="196"
             Background="#222222"
             BorderBrush="White"
             BorderThickness="0,0,0,1"
             Foreground="White"/>
        <Button x:Name="btnlogin" Content="Iniciar Sección" HorizontalAlignment="Left" Margin="427,251,0,0" VerticalAlignment="Top" Width="189" Height="44" Click="btnlogin_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#FF22C8F5" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Image Source="Images/grupos.png" Margin="351,199,352,206"/>
        <ComboBox x:Name="cbrol" HorizontalAlignment="Left" Margin="438,208,0,0" VerticalAlignment="Top" Width="185">
            <ComboBoxItem>Recepcionista</ComboBoxItem>
            <ComboBoxItem>Odontólogo</ComboBoxItem>
        </ComboBox>
        <Button x:Name="btnsalir" Width="44" Height="41" HorizontalAlignment="Center" VerticalAlignment="Center" 
        Margin="746,10,10,399" Background="Transparent" BorderBrush="#A593DC" BorderThickness="2" Click="btnsalir_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" BorderBrush="#A593DC" BorderThickness="2" 
                    Width="40" Height="40" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Content>
                <TextBlock FontSize="20" Text="X" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button.Content>
        </Button>





      






    </Grid>
</Window>
