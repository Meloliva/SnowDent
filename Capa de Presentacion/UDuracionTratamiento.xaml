<UserControl x:Class="Capa_de_Presentacion.UDuracionTratamiento"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1200">
    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Width="Auto">

                <!-- Título -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,20,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Duración Promedio de Tratamientos"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Contenido Principal -->
                <Border Background="White" CornerRadius="20" Padding="30" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch" Height="380">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="5" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" Margin="0" HorizontalAlignment="Stretch">
                        <!-- Controles de búsqueda fuera del margen de la gráfica -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                            <TextBlock Text="Buscar por DNI:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtDni" Width="140" Height="30" Background="#EAF7FF" BorderBrush="Transparent"
                                  FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnBuscar" Content="🔍 Buscar" Width="90" Height="30" Background="#3498DB" Foreground="White"
                                 FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Click="BtnBuscar_Click"/>
                        </StackPanel>

                        <!-- Aquí sigue la gráfica y el resto de los controles -->
                        <lvc:CartesianChart x:Name="barChartTratamientos"
                                            Height="320"
                                            Margin="0,0,0,20"
                                            LegendLocation="None"
                                            DisableAnimations="True"/>

                        <Border Background="#FFFFFF" CornerRadius="10" Padding="10" HorizontalAlignment="Stretch">
                            <DataGrid x:Name="dgDuracionTratamientos"
                                      AutoGenerateColumns="True"
                                      FontSize="13"
                                      AlternatingRowBackground="#F2F9FF"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MinHeight="180" Height="294"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>