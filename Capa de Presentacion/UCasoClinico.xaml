<UserControl x:Class="Capa_de_Presentacion.UCasoClinico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capa_de_Presentacion"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1200">
    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Width="Auto">
                <!-- Título -->
                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="4" Opacity="0.2"/>
                    </Border.Effect>
                    <TextBlock Text="Registro de Caso Clínico"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Formulario -->
                <Border Background="White" CornerRadius="20" Padding="30" Margin="0,0,0,20"
                        HorizontalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="5" Opacity="0.2"/>
                    </Border.Effect>

                    <StackPanel Orientation="Vertical" Margin="0" HorizontalAlignment="Stretch">
                        <!-- Fila 1: DNI y Buscar -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                            <TextBlock Text="DNI del Paciente:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDni" Width="120" Height="30" Background="#EAF7FF" BorderBrush="Transparent"
                                     VerticalContentAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
                            <Button x:Name="BtnBuscar" Content="🔍 Buscar" Width="90" Height="30" Background="#3498DB" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="8" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>

                        <!-- Fila 2: Nombre y Fecha -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                            <TextBlock Text="Nombre del Paciente:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNombre" Width="150" Height="30" IsReadOnly="True" Background="#F0F0F0"
                                     BorderBrush="Transparent" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,20,0"/>
                            <TextBlock Text="Nombre del Odontologo:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtNombreOdontologo" Width="150" Height="30" IsReadOnly="True" Background="#F0F0F0"
                                     BorderBrush="Transparent" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,20,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                <TextBlock Text="Fecha de Inicio:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <DatePicker x:Name="DpFechaInicio" Width="150"/>
                            <TextBlock Text="Fecha de Fin:" FontWeight="SemiBold" Margin="30,0,10,0" VerticalAlignment="Center"/>
                            <DatePicker x:Name="DpFechaFin" Width="150"/>
                        </StackPanel>

                        <!-- Fila 3: Tipo y Estado -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                            <TextBlock Text="Tipo de Tratamiento:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbTipoTratamiento" Width="160" Background="#EAF7FF" BorderBrush="Transparent" Margin="0,0,20,0" DisplayMemberPath="Nombre" SelectedValuePath="IdTipoTratamiento">
                                
                            </ComboBox>
                            <TextBlock Text="Estado:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbEstado" Width="120" Background="#EAF7FF" BorderBrush="Transparent">
                                <ComboBoxItem Content="Inicio"/>
                                <ComboBoxItem Content="En progreso"/>
                                <ComboBoxItem Content="Terminado"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- Fila 2.1: Fecha y hora de próxima cita -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                            <TextBlock Text="Fecha de próxima cita:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <DatePicker x:Name="DpProximaCita" Width="150" Margin="0,0,20,0"/>
                            <TextBlock Text="Hora de próxima cita:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHoraProximaCita" Width="100" Height="30" Background="#EAF7FF" BorderBrush="Transparent"
                            VerticalContentAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Diagnostico:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtDiagnostico"
                                 Height="80"
                                 Margin="0,0,0,10"
                                 Background="#EAF7FF"
                                 BorderBrush="Transparent"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                  AcceptsReturn="True"
                                  VerticalScrollBarVisibility="Auto"/>


                        <!-- Botones -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button x:Name="btnguardar" Content="💾 Guardar" Width="120" Height="40" Background="#5EB956" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btneditar" Content="✏️ Editar" Width="120" Height="40" Background="Gray" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <Button x:Name="btneliminar" Content="🗑️ Eliminar" Width="120" Height="40" Background="Red" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>
                            <Button x:Name="btnlimpiar" Content=" Limpiar" Width="120" Height="40" Background="#F1AC17" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" FontSize="13" Cursor="Hand" Margin="5,0" Click="BtnLimpiar_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>

                        <!-- DataGrid -->
                        <TextBlock Text="Historial clinico del paciente:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch">
                            <DataGrid AutoGenerateColumns="False"
                                        FontSize="13"
                                        AlternatingRowBackground="#F2F9FF"
                                        HeadersVisibility="Column"
                                        GridLinesVisibility="None"
                                         BorderThickness="0"
                                         CanUserAddRows="False"
                                         IsReadOnly="True"
                                         MinHeight="180"
                                         x:Name="dgCasosClinicos"
                                         HorizontalAlignment="Stretch"
                                         SelectionMode="Single"
                                         SelectionChanged="DgCasosClinicos_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Inicio" Binding="{Binding InicioTratamiento, StringFormat=d}" />
                                    <DataGridTextColumn Header="Fin" Binding="{Binding FinTratamiento, StringFormat=d}" />
                                    <DataGridTextColumn Header="Próxima Cita" Binding="{Binding FechaProximaCita, StringFormat=d}" />
                                    <DataGridTextColumn Header="Hora" Binding="{Binding HoraProximaCita}" />
                                    <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" />
                                    <DataGridTextColumn Header="DNI Paciente" Binding="{Binding PacienteDNI}" />
                                    <DataGridTextColumn Header="Odontologo" Binding="{Binding Odontologo}" />
                                    <DataGridTextColumn Header="TipoTratamiento" Binding="{Binding Nombre}" />
                                    <DataGridTextColumn Header="Diagnóstico" Binding="{Binding Diagnostico}" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" />
                                    <DataGridTextColumn Header="CitaId" Binding="{Binding CitaId}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
